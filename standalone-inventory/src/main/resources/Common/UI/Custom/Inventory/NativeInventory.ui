$C = "../Common.ui";

@GridStyle = ItemGridStyle(
  SlotSize: 56,
  SlotIconSize: 48,
  SlotSpacing: 3,
  SlotBackground: "../Common/BlockSelectorSlotBackground.png"
);
@SectionStyle = LabelStyle(FontSize: 14, RenderBold: true, TextColor: #b9cddd, VerticalAlignment: Center);

Group #NativeInventory {
  FlexWeight: 1;
  LayoutMode: Top;

  Label {
    Anchor: (Height: 38, Bottom: 6);
    Text: "Click an item, then click its destination to move the whole stack.";
    Style: (FontSize: 13, TextColor: #a7bacc, Wrap: true, VerticalAlignment: Center);
  }
  Group {
    Anchor: (Height: 42, Bottom: 8);
    LayoutMode: Left;
    Label #Status {
      FlexWeight: 1;
      Style: (FontSize: 13, TextColor: #e6bd78, Wrap: true, VerticalAlignment: Center);
      Text: "Select an item.";
    }
    TextButton #ClearSelectionButton {
      Anchor: (Width: 150, Height: 36);
      Text: "Clear selection";
      Style: $C.@SecondaryTextButtonStyle;
    }
  }
  Group {
    FlexWeight: 1;
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
    Label { Anchor: (Height: 26); Style: @SectionStyle; Text: "Storage"; }
    ItemGrid #StorageGrid {
      Anchor: (Height: 184, Bottom: 12);
      SlotsPerRow: 9;
      InventorySectionId: -2;
      AreItemsDraggable: false;
      RenderItemQualityBackground: true;
      Style: @GridStyle;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }
    Label { Anchor: (Height: 26); Style: @SectionStyle; Text: "Hotbar"; }
    ItemGrid #HotbarGrid {
      Anchor: (Height: 60, Bottom: 12);
      SlotsPerRow: 9;
      InventorySectionId: -1;
      AreItemsDraggable: false;
      RenderItemQualityBackground: true;
      Style: @GridStyle;
    }
    Group {
      Anchor: (Height: 98, Bottom: 12);
      LayoutMode: Left;
      Group {
        Anchor: (Width: 262, Right: 18);
        LayoutMode: Top;
        Label { Anchor: (Height: 26); Style: @SectionStyle; Text: "Armor"; }
        ItemGrid #ArmorGrid {
          Anchor: (Height: 60);
          SlotsPerRow: 4;
          InventorySectionId: -3;
          AreItemsDraggable: false;
          RenderItemQualityBackground: true;
          Style: @GridStyle;
        }
      }
      Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Label { Anchor: (Height: 26); Style: @SectionStyle; Text: "Utility"; }
        ItemGrid #UtilityGrid {
          Anchor: (Height: 60);
          SlotsPerRow: 4;
          InventorySectionId: -5;
          AreItemsDraggable: false;
          RenderItemQualityBackground: true;
          Style: @GridStyle;
        }
      }
    }
    Label { Anchor: (Height: 26); Style: @SectionStyle; Text: "Backpack"; }
    ItemGrid #BackpackGrid {
      Anchor: (Height: 184, Bottom: 12);
      SlotsPerRow: 9;
      InventorySectionId: -9;
      AreItemsDraggable: false;
      RenderItemQualityBackground: true;
      Style: @GridStyle;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }
  }
}
