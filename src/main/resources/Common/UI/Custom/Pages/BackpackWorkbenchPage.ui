$C = "../Common.ui";
@WorkbenchContentPadding = Padding(Horizontal: 12, Vertical: 6);
Group #Main {
  FlexWeight: 1;
  LayoutMode: Top;
  Group #BackpackHeader {
    Anchor: (Height: 48, Bottom: 6);
    Padding: (Full: 3);
    LayoutMode: Left;
    Background: #141c24(0.9);
    ItemSlot #CurrentIcon {
      Anchor: (Width: 42, Height: 42, Right: 10);
      ShowQualityBackground: true;
      ShowQuantity: false;
    }
    Group #HeaderDetails {
      FlexWeight: 1;
      Label #HeaderContext { Anchor: (Left: 0, Right: 160, Top: 0, Height: 16); Style: (FontSize: 11, RenderBold: true, RenderUppercase: true, TextColor: #96a9be, VerticalAlignment: Center, ShrinkTextToFit: true); }
      Label #CurrentName { Anchor: (Left: 0, Right: 160, Top: 16, Height: 22); Style: (RenderBold: true, FontSize: 15, TextColor: #e6be65, HorizontalAlignment: Start, VerticalAlignment: Center, ShrinkTextToFit: true); }
      Label #CurrentInfo { Anchor: (Right: 0, Top: 0, Width: 150, Height: 42); Style: (FontSize: 13, TextColor: #bdcbd3, HorizontalAlignment: End, VerticalAlignment: Center, ShrinkTextToFit: true); }
    }
  }
  // Forms keep their footer visible; their long content owns its scrolling.
  Group #WorkbenchList {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Horizontal: 2, Vertical: 1);
  }
  Group #LoadingContainer {
    FlexWeight: 1;
    LayoutMode: MiddleCenter;
    Visible: false;
    Label #LoadingText {
      Style: (FontSize: 18, TextColor: #96a9be, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true);
      Text: "Loading...";
    }
  }
  Label #StatusMessage {
    Anchor: (Height: 28, Top: 4);
    Padding: (Horizontal: 4);
    Style: (FontSize: 12, TextColor: #62b78d, HorizontalAlignment: Start, VerticalAlignment: Center, ShrinkTextToFit: true);
    Visible: false;
  }
}
