$C = "../Common.ui";

@BenchUpgradeLabelStyle = LabelStyle(...$C.@DefaultButtonLabelStyle, FontSize: 14);
@BenchUpgradeButtonStyle = TextButtonStyle(
  Default: (Background: $C.@DefaultButtonDefaultBackground, LabelStyle: @BenchUpgradeLabelStyle),
  Hovered: (Background: $C.@DefaultButtonHoveredBackground, LabelStyle: @BenchUpgradeLabelStyle),
  Pressed: (Background: $C.@DefaultButtonPressedBackground, LabelStyle: @BenchUpgradeLabelStyle),
  Disabled: (Background: $C.@DefaultButtonDisabledBackground, LabelStyle: (...@BenchUpgradeLabelStyle, TextColor: $C.@ColorDisabled)),
  Sounds: $C.@ButtonSounds
);

$C.@DecoratedContainer {
  @CloseButton = true;
  Anchor: (Width: 1060, Height: 620);

  #Title {
    Label #PageTitle {
      Style: (
        FontSize: 20,
        TextColor: #ffffff,
        RenderBold: true,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
      Padding: (Horizontal: 19);
      Text: "Backpack Workbench";
    }
  }

  #Content {
    LayoutMode: Left;
    Padding: (Horizontal: 16, Vertical: 12);
    Group #Main {
      FlexWeight: 1;
      LayoutMode: Top;

    // Active Backpack Header Card
    Group #BackpackHeader {
      Anchor: (Height: 64, Bottom: 10);
      Padding: (Full: 8);
      LayoutMode: Left;
      Background: #141c24(0.9);

      ItemSlot #CurrentIcon {
        Anchor: (Width: 48, Height: 48, Right: 10);
        ShowQualityBackground: true;
      }

      Group #HeaderDetails {
        FlexWeight: 1;
        LayoutMode: Top;

        Label #CurrentName {
          Style: (RenderBold: true, FontSize: 15, TextColor: #e6be65, ShrinkTextToFit: true);
        }

        Label #CurrentInfo {
          Anchor: (Top: 2);
          Style: (FontSize: 12, TextColor: #96a9be);
        }

        Label #StatusMessage {
          Anchor: (Top: 2);
          Style: (FontSize: 11, TextColor: #4cd137);
        }
      }
    }

    // Crafting and capacity upgrades share one page.
    Group #TabButtons {
      Anchor: (Height: 38, Bottom: 10);
      LayoutMode: Left;

    TextButton #CraftingButton {
      FlexWeight: 1;
      Anchor: (Height: 36, Right: 3);
      Text: "Craft & upgrade";
      Style: $C.@SecondaryTextButtonStyle;
    }


      TextButton #TabPersonalizeButton {
        FlexWeight: 1;
        Anchor: (Height: 36, Left: 3, Right: 3);
        Text: "Personalize";
        Style: $C.@SecondaryTextButtonStyle;
      }
      TextButton #TabVisibilityButton {
        FlexWeight: 1;
        Anchor: (Height: 36, Left: 3);
        Text: "Visibility";
        Style: $C.@SecondaryTextButtonStyle;
      }
    }

    // Panels fit the available height; only recipe lists can scroll.
    Group #WorkbenchList {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Full: 4);
    }

    // Centered loading state: only the text appears inside the UI
    Group #LoadingContainer {
      FlexWeight: 1;
      LayoutMode: MiddleCenter;
      Visible: false;

      Label #LoadingText {
        Style: (
          FontSize: 20,
          TextColor: #96a9be,
          RenderBold: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
        Text: "Carregando...";
      }
    }
    }
    $C.@SimpleContainer #BenchPanel {
      Anchor: (Width: 258, Left: 12);
      LayoutMode: Top;
      Padding: 0;

      Label #BenchName {
        Anchor: (Height: 42);
        Background: #0c151e(0.55);
        Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #bdcbd3, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true);
      }
      Label #BenchLevel { Anchor: (Height: 38, Top: 10); Style: (FontSize: 16, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center); }
      Group { Anchor: (Height: 130); LayoutMode: MiddleCenter;
        ItemSlot #BenchPreview { Anchor: (Width: 126, Height: 126); ShowQualityBackground: false; ShowQuantity: false; }
      }
      Label #BenchMax {
        Anchor: (Height: 38, Top: 4);
        Background: #0c151e(0.55);
        Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #bdcbd3, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true);
      }
      Group #BenchRequirements { Anchor: (Height: 92, Top: 10); LayoutMode: Left; Padding: (Horizontal: 8); }
      TextButton #BenchUpgradeButton { Anchor: (Height: 44, Horizontal: 12, Top: 8); Text: "Upgrade"; Style: @BenchUpgradeButtonStyle; }
      Group #BenchProgressContainer { Anchor: (Height: 10, Horizontal: 12, Top: 12); Visible: false;
        ProgressBar #BenchProgressBar {
          Anchor: (Full: 0);
          Value: 0;
          Background: "../Common/ProgressBar.png";
          BarTexturePath: "../Common/ProgressBarFill.png";
          EffectTexturePath: "../Common/ProgressBarEffect.png";
          EffectWidth: 53;
          EffectHeight: 30;
          EffectOffset: 38;
        }
      }
    }
  }
}
