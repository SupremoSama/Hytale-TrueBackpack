$C = "../Common.ui";
$G = "BackpackInventoryStyle.ui";

@SectionLabelStyle = LabelStyle(FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #878e9c, VerticalAlignment: Center);
@StatValueStyle = LabelStyle(FontSize: 14, RenderBold: true, TextColor: #b4c8c9, HorizontalAlignment: Start, VerticalAlignment: Center);
@StatCaptionStyle = LabelStyle(FontSize: 11, TextColor: #878e9c, HorizontalAlignment: Start, VerticalAlignment: Center);
@CharacterPanelButtonStyle = ButtonStyle(
  Default: (Background: "../BackpackNative/CharacterPanelButton.png"),
  Sounds: $C.@ButtonSounds
);

$C.@DecoratedContainer #PlayerPanel {
  FlexWeight: 1;
  #Title {
    Label #PlayerName {
      Anchor: (Full: 0);
      Padding: (Horizontal: 16);
      Style: (FontName: "Secondary", FontSize: 15, RenderBold: true, RenderUppercase: true, TextColor: #b4c8c9, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true);
      Text: "Player";
    }
  }
  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 14, Vertical: 12);
    Group #EquipmentArea {
      Anchor: (Height: 490, Bottom: 18);
      Group {
        Anchor: (Width: 420, Height: 396, Bottom: -50);
        Background: "../BackpackNative/CharacterBackground.png";
        HitTestVisible: false;
      }
      CharacterPreviewComponent #CharacterPreview {
        Anchor: (Height: 365, Top: 0, Left: -8, Right: -8);
        Padding: (Left: 78, Right: 78);
      }
      ItemGrid #ArmorGrid {
        Anchor: (Left: 0, Top: 50, Width: 74, Height: 304);
        SlotsPerRow: 1;
        InventorySectionId: -3;
        AreItemsDraggable: true;
        RenderItemQualityBackground: true;
        Style: $G.@InventoryGridStyle;
      }
      // Use the native render preferences, leaving armor equipped and its stats intact.
      Button #HelmetVisibility {
        Anchor: (Left: 54, Top: 46, Width: 32, Height: 32);
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Group #Visible { HitTestVisible: false; Anchor: (Full: 0); Background: "../BackpackNative/ArmorVisibilityOn.png"; }
        Group #Hidden { HitTestVisible: false; Anchor: (Full: 0); Background: "../BackpackNative/ArmorVisibilityOff.png"; Visible: false; }
      }
      Button #CuirassVisibility {
        Anchor: (Left: 54, Top: 122, Width: 32, Height: 32);
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Group #Visible { HitTestVisible: false; Anchor: (Full: 0); Background: "../BackpackNative/ArmorVisibilityOn.png"; }
        Group #Hidden { HitTestVisible: false; Anchor: (Full: 0); Background: "../BackpackNative/ArmorVisibilityOff.png"; Visible: false; }
      }
      Button #GauntletsVisibility {
        Anchor: (Left: 54, Top: 198, Width: 32, Height: 32);
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Group #Visible { HitTestVisible: false; Anchor: (Full: 0); Background: "../BackpackNative/ArmorVisibilityOn.png"; }
        Group #Hidden { HitTestVisible: false; Anchor: (Full: 0); Background: "../BackpackNative/ArmorVisibilityOff.png"; Visible: false; }
      }
      Button #PantsVisibility {
        Anchor: (Left: 54, Top: 274, Width: 32, Height: 32);
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Group #Visible { HitTestVisible: false; Anchor: (Full: 0); Background: "../BackpackNative/ArmorVisibilityOn.png"; }
        Group #Hidden { HitTestVisible: false; Anchor: (Full: 0); Background: "../BackpackNative/ArmorVisibilityOff.png"; Visible: false; }
      }
      Group {
        Anchor: (Right: 0, Top: 98, Width: 72, Height: 212);
        Background: "../BackpackNative/SubMenuBackground.png";
        Button #CharacterCraftingButton {
          Anchor: (Left: 1, Top: 4, Width: 70, Height: 70);
          Style: @CharacterPanelButtonStyle;
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
          Group #CharacterCraftingActive { Anchor: (Full: 0); Background: "../BackpackNative/CharacterPanelButtonActive.png"; Visible: false; }
          Group { Anchor: (Width: 48, Height: 48); Background: "../BackpackNative/PocketCraftingIcon.png"; }
        }
        Button #CharacterVisibilityButton {
          Anchor: (Left: 1, Top: 71, Width: 70, Height: 70);
          Style: @CharacterPanelButtonStyle;
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
          Group #CharacterVisibilityActive { Anchor: (Full: 0); Background: "../BackpackNative/CharacterPanelButtonActive.png"; Visible: false; }
          Group { Anchor: (Width: 32, Height: 32); Background: "../BackpackNative/ArmorVisibilityOn.png"; }
        }
        Button #CharacterPersonalizeButton {
          Anchor: (Left: 1, Top: 138, Width: 70, Height: 70);
          Style: @CharacterPanelButtonStyle;
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
          Group #CharacterPersonalizeActive { Anchor: (Full: 0); Background: "../BackpackNative/CharacterPanelButtonActive.png"; Visible: false; }
          Group { Anchor: (Width: 50, Height: 50); Background: "../BackpackNative/BackpackIcon.png"; }
        }
      }
      Group #UtilitySection {
        Anchor: (Left: 0, Right: 0, Bottom: 20, Height: 80);
        ItemGrid #UtilityGrid {
          Anchor: (Width: 302, Height: 74, Top: 3);
          SlotsPerRow: 4;
          InventorySectionId: -5;
          AreItemsDraggable: true;
          RenderItemQualityBackground: true;
          Style: $G.@InventoryGridStyle;
        }
      }
    }
    $C.@SimpleContainer #StatsPanel {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Full: 10);
      Label #StatsTitle { Anchor: (Height: 22, Bottom: 4); Style: @SectionLabelStyle; Text: "Statistics"; }
      Group {
        Anchor: (Height: 48); LayoutMode: Left;
        Group {
          FlexWeight: 1;
          Group { Anchor: (Left: 0, Top: 6, Width: 35, Height: 35); Background: "../BackpackNative/CharacterPanelStatIconBackground.png";
            Group { Anchor: (Full: 0); Background: "../BackpackNative/CharacterPanelStatIconHealth.png"; }
          }
          Label #HealthLabel { Anchor: (Left: 43, Right: 0, Top: 3, Height: 18); Style: @StatCaptionStyle; Text: "Health"; }
          Label #StatHealth { Anchor: (Left: 43, Right: 0, Top: 21, Height: 20); Style: @StatValueStyle; Text: "—"; }
        }
        Group {
          FlexWeight: 1;
          Group { Anchor: (Left: 0, Top: 6, Width: 35, Height: 35); Background: "../BackpackNative/CharacterPanelStatIconBackground.png";
            Group { Anchor: (Full: 0); Background: "../BackpackNative/CharacterPanelStatIconStamina.png"; }
          }
          Label #StaminaLabel { Anchor: (Left: 43, Right: 0, Top: 3, Height: 18); Style: @StatCaptionStyle; Text: "Stamina"; }
          Label #StatStamina { Anchor: (Left: 43, Right: 0, Top: 21, Height: 20); Style: @StatValueStyle; Text: "—"; }
        }
      }
      Group { Anchor: (Height: 1, Vertical: 3); Background: #ffffff(0.06); }
      Group {
        Anchor: (Height: 48); LayoutMode: Left;
        Group {
          FlexWeight: 1;
          Group { Anchor: (Left: 0, Top: 6, Width: 35, Height: 35); Background: "../BackpackNative/CharacterPanelStatIconBackground.png";
            Group { Anchor: (Full: 0); Background: "../BackpackNative/CharacterPanelStatIconMana.png"; }
          }
          Label #ManaLabel { Anchor: (Left: 43, Right: 0, Top: 3, Height: 18); Style: @StatCaptionStyle; Text: "Mana"; }
          Label #StatMana { Anchor: (Left: 43, Right: 0, Top: 21, Height: 20); Style: @StatValueStyle; Text: "—"; }
        }
        Group {
          FlexWeight: 1;
          Group { Anchor: (Left: 0, Top: 6, Width: 35, Height: 35); Background: "../BackpackNative/CharacterPanelStatIconBackground.png";
            Group { Anchor: (Full: 0); Background: "../BackpackNative/CharacterPanelStatIconArmor.png"; }
          }
          Label #DefenseLabel { Anchor: (Left: 43, Right: 0, Top: 3, Height: 18); Style: @StatCaptionStyle; Text: "Defense"; }
          Label #StatDefense { Anchor: (Left: 43, Right: 0, Top: 21, Height: 20); Style: @StatValueStyle; Text: "—"; }
        }
      }
    }
  }
}
