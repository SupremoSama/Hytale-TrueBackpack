$C = "../Common.ui";
Group {
  LayoutMode: Top;
  FlexWeight: 1;
  Padding: (Full: 6);
  Label #NameTitle { Anchor: (Height: 20); Text: "Backpack name"; Style: (FontSize: 13, TextColor: #bdcbd3, ShrinkTextToFit: true); }
  $C.@TextField #BackpackName { @Anchor = (Height: 32, Bottom: 8); PlaceholderText: "Leave empty for the original name"; }
  Group {
    LayoutMode: Left;
    FlexWeight: 1;
    Group {
      FlexWeight: 1;
      Anchor: (Right: 16);
      LayoutMode: Top;
      Label #PreviewTitle { Anchor: (Height: 24); Text: "Preview"; Style: (FontSize: 13, TextColor: #bdcbd3, HorizontalAlignment: Center); }
      Group #PaintPreviewHost { LayoutMode: Top; FlexWeight: 1; }
    }
    Group {
      LayoutMode: Top;
      Anchor: (Width: 350);
      Label #AppearanceTitle { Anchor: (Height: 20); Text: "Appearance"; Style: (FontSize: 13, TextColor: #bdcbd3); }
      $C.@DropdownBox #AppearanceSelect { @Anchor = (Bottom: 8); }
      Group #PaintControls {
        LayoutMode: Top;
        Group {
          LayoutMode: Left;
          Anchor: (Height: 28);
          $C.@CheckBox #UsePaint { Anchor: (Width: 22, Height: 22, Right: 8); }
          Label #UsePaintLabel { FlexWeight: 1; Anchor: (Height: 22); Text: "Custom color"; Style: (FontSize: 13, TextColor: #bdcbd3, VerticalAlignment: Center); }
        }
        ColorPicker #PaintPicker { Anchor: (Width: 290, Height: 190); Format: Rgb; Style: $C.@DefaultColorPickerStyle; }
      }
      Label #PaintExcluded { Anchor: (Height: 90); Text: "This backpack cannot be painted."; Style: (FontSize: 12, TextColor: #bdcbd3, Wrap: true); }
    }
  }
  Label #PreviewHint { Anchor: (Height: 24); Text: "Preview your changes, then save."; Style: (FontSize: 11, TextColor: #96a9be, ShrinkTextToFit: true); }
  Group {
    LayoutMode: Left;
    Anchor: (Height: 34);
    TextButton #SaveCustomization { Anchor: (Width: 210, Height: 32); Text: "Save changes"; Style: $C.@SmallSecondaryTextButtonStyle; }
    Label #PreviewColor { FlexWeight: 1; Anchor: (Height: 32, Left: 8); Style: (FontSize: 12, TextColor: #bdcbd3, HorizontalAlignment: End, VerticalAlignment: Center); }
  }
}
