$C = "../Common.ui";

Group #UpgradeEntry {
  Anchor: (Height: 56, Bottom: 4);
  Padding: (Full: 4);
  LayoutMode: Left;
  Background: #141c24(0.85);

  ItemSlot #UpgradeIcon {
    Anchor: (Width: 44, Height: 44, Right: 8);
    ShowQualityBackground: true;
  }

  Group #Details {
    FlexWeight: 1;
    LayoutMode: Top;

    Label #UpgradeTitle {
      Style: (RenderBold: true, FontSize: 13, TextColor: #e6be65, ShrinkTextToFit: true);
    }

    Label #UpgradeBenefits {
      Anchor: (Top: 1);
      Style: (FontSize: 12, TextColor: #55efc4);
    }

    Label #CostLabel {
      Anchor: (Top: 1);
      Style: (FontSize: 12, TextColor: #dfe6e9, ShrinkTextToFit: true);
    }
  }

  TextButton #UpgradeButton {
    Anchor: (Width: 110, Height: 32, Left: 8, Top: 8);
    Text: "Upgrade";
    Style: $C.@SmallSecondaryTextButtonStyle;
  }

  Group #NeedItemsBadge {
    Anchor: (Width: 110, Height: 32, Left: 8, Top: 8);
    Background: #1c242c(0.95);
    LayoutMode: Center;
    Visible: false;

    Label #NeedItemsText {
      Text: "Need Items";
      Style: (
        FontSize: 12,
        TextColor: #7f8c8d,
        RenderBold: true,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }
  }

  Group #MaxedBadge {
    Anchor: (Width: 110, Height: 32, Left: 8, Top: 8);
    Background: #2a2414(0.95);
    LayoutMode: Center;
    Visible: false;

    Label #MaxedText {
      Text: "Maxed";
      Style: (
        FontSize: 12,
        TextColor: #e6be65,
        RenderBold: true,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }
  }

  Group #MemoryLockBadge {
    Anchor: (Width: 110, Height: 32, Left: 8, Top: 8);
    Padding: (Horizontal: 6);
    LayoutMode: Left;
    Background: #101b25;
    Visible: false;
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
    Group { Anchor: (Width: 24, Height: 24, Top: 5, Right: 6); Background: "../BackpackNative/MemoryLocked.png"; }
    Label #MemoryLockCount { FlexWeight: 1; Style: (FontSize: 12, TextColor: #bdcbd3, VerticalAlignment: Center, HorizontalAlignment: Center, ShrinkTextToFit: true); }
  }
}
